# =============================================================================
# SignalForge 환경변수 설정 (.env.example)
# 사용: cp .env.example .env  →  .env 수정 후 ./scripts/build.sh && ./scripts/up.sh
# =============================================================================

# ── 앱 식별자 (같은 서버에 여러 인스턴스 공존 시 변경) ───────────────────
# Apptainer instance 이름 prefix: sf_postgres, sf-backend 등에 사용됨
APP_NAME=sf

# ── 프록시 (사내망 등) ────────────────────────────────────────────────────
# 외부 환경(사내망 밖)에서 프록시 완전 비활성: BUILD_PROXY_HTTPS=off
# _common.sh 의 DEFAULT_FALLBACK_PROXY (168.219.61.252:8080) 가 자동 적용됨
# NO_PROXY — 포털 도메인은 사내 프록시를 타면 끊긴다(코어 받기 curl 56). 자리표시를 실제 포털 도메인으로 바꾼다.
# localhost · 127.0.0.1 · ::1 은 스크립트가 늘 덧붙인다. 따옴표를 지우지 않는다(.env 는 bash 가 읽는다)
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY="<포털 도메인>"
BUILD_PROXY_HTTPS=
BUILD_PROXY_HTTP=

# ── PostgreSQL (Apptainer instance) ─────────────────────────────────────────
POSTGRES_USER=signalforge
POSTGRES_PASSWORD=signalforge_pass
POSTGRES_DB=signalforge
POSTGRES_HOST=127.0.0.1
# 호스트가 이미 5432 점유 중이면 다른 포트로 변경
POSTGRES_PORT=5432
# shared_buffers (선택). 비우면 기본 128MB 그대로. 메모리 여유가 있는 서버(cae00)만 올린다 —
# 기본값은 OS 페이지 캐시에 기대 캐시가 갈리면 브랜드·전역 검색이 6~16초 걸렸다. postgres 가
# 꺼져 있을 때 up.sh 가 postgresql.auto.conf 에 쓴다(떠 있으면 다시 띄울 때 적용). 메모리 40% 상한.
# PG_SHARED_BUFFERS=4GB

# ── Redis (시스템 서비스 — sudo grep requirepass /etc/redis/redis.conf) ────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=Soseks314!
# REDIS_URL 은 up.sh 가 위 변수로부터 자동 생성 (수동 override 가능)
REDIS_URL=

# ── Claude API (NLP + MCP) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── LLM 인사이트 (Track B) ──────────────────────────────────────────────────
# crawler/insight/daily_insight.py — 어제 VOC 데이터를 LLM 으로 요약
# 우선순위: ANTHROPIC_API_KEY (claude-sonnet-4-5) → OPENAI_API_KEY (gpt-4o-mini)
# 둘 다 비워두면 LLM 호출은 skip 되고 raw 요약만 reports/insight_YYYY-MM-DD.md 에 저장됨
OPENAI_API_KEY=
# 선택: LLM 타임아웃 / 출력 토큰 한계 / 재시도 횟수 (기본값 사용 OK)
LLM_TIMEOUT_SEC=60
LLM_MAX_TOKENS=4096
LLM_RETRY=1
# 선택: 보고서 출력 디렉토리 (기본: <repo>/reports)
REPORT_DIR=

# ── 번역 ────────────────────────────────────────────────────────────────────
DEEPL_API_KEY=
LIBRE_TRANSLATE_URL=

# ── Reddit API (PRAW) ───────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SignalForge/1.0

# ── Naver Cafe (선택) ───────────────────────────────────────────────────────
NAVER_ID=
NAVER_PASSWORD=

# ── Twitter / X ─────────────────────────────────────────────────────────────
TWITTER_USERNAME=
TWITTER_PASSWORD=

# ── Backend API ─────────────────────────────────────────────────────────────
# 백엔드가 듣는 주소 — 포털 nginx 가 같은 서버에서 127.0.0.1 로 닿으면 127.0.0.1 로 둔다(SSO 게이트 밖인 /ws/realtime 이
# 바깥에서 닿지 않게). 2026-11-27 이전 backend 이미지는 이 값을 읽지 않고 늘 0.0.0.0 이다
API_HOST=0.0.0.0
API_PORT=18000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 크롤러·인사이트 계층이 백엔드를 부를 때 쓰는 주소(API_PORT 와 맞춘다).
SIGNALFORGE_API=http://127.0.0.1:18000
API_KEY=change-me
DEBUG=false
LOG_LEVEL=INFO

# ── HWAX Portal SSO (optional) ──────────────────────────────────────────────
# 비어 있으면 SSO 비활성: portal-callback 은 404, /api/v1 게이트 off (standalone 그대로).
# 활성화하려면 PORTAL_JWKS_URL + SF_SESSION_SECRET 를 채운다.
PORTAL_JWKS_URL=
PORTAL_AUDIENCE=signalforge
# openssl rand -hex 32 로 생성. SSO 활성 시 필수.
SF_SESSION_SECRET=
SESSION_COOKIE_PATH=/signalforge/
SESSION_TTL_SECONDS=43200
PORTAL_SSO_LANDING=/signalforge/

# ── PLM 거울 · 코어 온톨로지 (SP 허브, 선택) ─────────────────────────────────
# 포털 경로 꼴 — rootdesign 이 두 번인 까닭: 앞은 포털이 앱을 거는 경로, 뒤는 허브 API 의 경로다(허브 직결이면 앞이 없다).
# 토큰은 여기 적지 않는다 — 파일(crawler/data/plm/sp_token 또는 SF_SP_TOKEN_FILE)에만. 토큰 파일이 없으면 받기는 꺼진다.
# 처음 받기: bash scripts/plm-sync.sh --full
SF_SP_CORE_URL="https://<포털 도메인>/rootdesign/rootdesign/api"

# ── MCP 서버 ────────────────────────────────────────────────────────────────
MCP_PORT=8001

# ── Celery ──────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=4
