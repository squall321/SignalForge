Bootstrap: docker
From: python:3.12-slim

%labels
    Maintainer SignalForge
    Version 1.1
    Service mcp-server

%help
    SignalForge MCP 서버 컨테이너 (bind-mount 코드).
    실행: apptainer instance start --bind $PROJECT_ROOT/mcp-server:/mcp-server \
             --env MCP_PORT=8013 --env DATABASE_URL=... apptainer/sif/mcp.sif mcp-server

# 의존성은 mcp-server/requirements.txt 단일 소스에서 설치 → def 하드코딩 stale 방지.
%files
    mcp-server/requirements.txt /opt/requirements.txt

%post
    apt-get update && apt-get install -y \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir -r /opt/requirements.txt

%environment
    export PYTHONPATH=/mcp-server
    export PYTHONUNBUFFERED=1

%runscript
    cd /mcp-server && exec python server.py "$@"

%startscript
    cd /mcp-server && exec python server.py
