Bootstrap: docker
From: python:3.12-slim

%labels
    Maintainer SignalForge
    Version 1.1
    Service mcp-server

%help
    SignalForge MCP 서버 컨테이너 (bind-mount 코드).
    실행: apptainer instance start --bind $PROJECT_ROOT/mcp-server:/mcp-server \
             --env MCP_PORT=8013 --env DATABASE_URL=... apptainer/sif/mcp.sif mcp-server

# 의존성은 mcp-server/requirements.txt 단일 소스에서 설치 → def 하드코딩 stale 방지.
%files
    mcp-server/requirements.txt /opt/requirements.txt
    mcp-server/requirements.lock /opt/requirements.lock

%post
    apt-get update && apt-get install -y \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

    # 판은 lock 이 정한다(-c) — lock 에 없는 것(새로 넣은 numpy 등)만 requirements 범위의 최신으로
    pip install --no-cache-dir -r /opt/requirements.txt -c /opt/requirements.lock

%environment
    export PYTHONPATH=/mcp-server
    export PYTHONUNBUFFERED=1
    # 호스트 ~/.local 의 패키지를 섞지 않는다 — apptainer 가 $HOME 을 바인드해 사용자 site-packages 가
    # 이미지보다 먼저 잡혔고, dev 는 그 numpy 로 돌아 이미지에 numpy 가 없는 것을 몰랐다(cae00 2026-10-27).
    export PYTHONNOUSERSITE=1

%runscript
    cd /mcp-server && exec python server.py "$@"

%startscript
    cd /mcp-server && exec python server.py
