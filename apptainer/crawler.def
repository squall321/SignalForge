Bootstrap: docker
From: python:3.12-slim

%labels
    Maintainer SignalForge
    Version 1.1
    Service crawler

%help
    SignalForge Celery 크롤러 워커 컨테이너 (Playwright 포함, bind-mount 코드).
    빌드 후 worker/beat 둘 다 이 이미지를 사용한다.
    worker: apptainer instance start --bind $PROJECT_ROOT/crawler:/crawler apptainer/sif/crawler.sif celery-worker
    beat:   apptainer run --bind $PROJECT_ROOT/crawler:/crawler apptainer/sif/crawler.sif beat --loglevel=info

# 의존성은 crawler/requirements.txt 단일 소스에서 설치 → def 하드코딩 stale 방지.
%files
    crawler/requirements.txt /opt/requirements.txt
    crawler/requirements.lock /opt/requirements.lock

%post
    apt-get update && apt-get install -y \
        gcc \
        libpq-dev \
        curl \
        wget \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libdbus-1-3 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2 \
        libpango-1.0-0 \
        libcairo2 \
    && rm -rf /var/lib/apt/lists/*

    # 판은 lock 이 정한다(-c) — lock 에 없는 것(새로 넣은 numpy 등)만 requirements 범위의 최신으로
    pip install --no-cache-dir -r /opt/requirements.txt -c /opt/requirements.lock

    # Playwright Chromium 설치 (런타임 라이브러리는 위 apt-get 에서 이미 설치됨;
    # --with-deps 는 ttf-unifont / ttf-ubuntu-font-family 미존재(trixie)로 실패하므로 제거)
    playwright install chromium

%environment
    export PYTHONPATH=/crawler
    export PYTHONUNBUFFERED=1
    # 호스트 ~/.local 의 패키지를 섞지 않는다 — apptainer 가 $HOME 을 바인드해 사용자 site-packages 가
    # 이미지보다 먼저 잡혔고, dev 는 그 numpy 로 돌아 이미지에 numpy 가 없는 것을 몰랐다(cae00 2026-10-27).
    export PYTHONNOUSERSITE=1

%runscript
    # CELERY_ROLE=beat 이면 beat, 아니면 worker (단일 이미지로 worker/beat 공용).
    cd /crawler
    if [ "${CELERY_ROLE:-worker}" = "beat" ]; then
        exec celery -A celery_app beat --loglevel=info "$@"
    fi
    exec celery -A celery_app worker --loglevel=info --concurrency="${CELERY_CONCURRENCY:-4}" "$@"

%startscript
    cd /crawler
    if [ "${CELERY_ROLE:-worker}" = "beat" ]; then
        exec celery -A celery_app beat --loglevel=info
    fi
    exec celery -A celery_app worker --loglevel=info --concurrency="${CELERY_CONCURRENCY:-4}"
