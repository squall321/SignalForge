Bootstrap: docker
From: python:3.12-slim

%labels
    Maintainer SignalForge
    Version 1.1
    Service backend

%help
    SignalForge FastAPI 백엔드 컨테이너 (bind-mount: 코드는 호스트에서 마운트).
    실행: apptainer instance start --bind $PROJECT_ROOT/backend:/app \
             --env API_PORT=18000 --env DATABASE_URL=... apptainer/sif/backend.sif backend
    중지: apptainer instance stop backend

# 의존성은 backend/requirements.txt 단일 소스에서 설치 → def 하드코딩 stale 방지.
%files
    backend/requirements.txt /opt/requirements.txt
    backend/requirements.lock /opt/requirements.lock

%post
    apt-get update && apt-get install -y \
        gcc \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

    # 판은 lock 이 정한다(-c) — lock 에 없는 것(새로 넣은 numpy 등)만 requirements 범위의 최신으로
    pip install --no-cache-dir -r /opt/requirements.txt -c /opt/requirements.lock

%environment
    export PYTHONPATH=/app
    export PYTHONUNBUFFERED=1
    # 호스트 ~/.local 의 패키지를 섞지 않는다 — apptainer 가 $HOME 을 바인드해 사용자 site-packages 가
    # 이미지보다 먼저 잡혔고, dev 는 그 numpy 로 돌아 이미지에 numpy 가 없는 것을 몰랐다(cae00 2026-10-27).
    export PYTHONNOUSERSITE=1

%runscript
    exec uvicorn app.main:app --host 0.0.0.0 --port "${API_PORT:-8000}" "$@"

%startscript
    exec uvicorn app.main:app --host 0.0.0.0 --port "${API_PORT:-8000}"
